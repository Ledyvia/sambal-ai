# Copy file ini jadi ".env" lalu isi sesuai kondisi kamu

# Gemini API Key (dari https://aistudio.google.com/apikey)
GEMINI_API_KEY=isi_api_key_gemini_kamu_disini

# YouTube Data API v3 Key — OPSIONAL, buat fitur video tutorial di halaman resep & chat
# Daftar gratis di https://console.cloud.google.com/ -> aktifkan "YouTube Data API v3"
# Kalau dikosongkan, fitur video tutorial otomatis nonaktif (sistem tetap jalan normal)
YOUTUBE_API_KEY=

# Kunci rahasia buat session login (bebas isi teks acak apapun)
SECRET_KEY=ganti-dengan-teks-acak-rahasia-kamu

# Konfigurasi database MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sambal_ai
